        "wires": [[]]
    },
    {
        "id": "node008",
        "type": "ui_chart",
        "z": "f1a2b3c4",
        "name": "Hum history",
        "group": "uigrp002",
        "order": 2,
        "width": 6,
        "height": 4,
        "label": "Humidity (%)",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "",
        "dot": false,
        "ymin": "0",
        "ymax": "100",
        "removeOlder": 1,
        "removeOlderUnit": "3600",
        "removeOlderPoints": "100",
        "colors": ["#2ca02c"],
        "x": 520,
        "y": 240,
        "wires": [[]]
    },
    {
        "id": "node009",
        "type": "inject",
        "z": "f1a2b3c4",
        "name": "Start",
        "props": [{"p": "payload"}],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.5,
        "payload": "",
        "payloadType": "date",
        "x": 110,
        "y": 320,
        "wires": [["node010"]]
    },
    {
        "id": "node010",
        "type": "sqlite",
        "z": "f1a2b3c4",
        "mydb": "db001",
        "sqlquery": "fixed",
        "sql": "CREATE TABLE IF NOT EXISTS readings (id INTEGER PRIMARY KEY AUTOINCREMENT, temp REAL, humidity REAL, ts INTEGER)",
        "name": "Create table",
        "x": 310,
        "y": 320,
        "wires": [["node011"]]
    },
    {
        "id": "node011",
        "type": "sqlite",
        "z": "f1a2b3c4",
        "mydb": "db001",
        "sqlquery": "fixed",
        "sql": "SELECT temp, humidity, ts FROM readings ORDER BY ts ASC LIMIT 100",
        "name": "Load history",
        "x": 510,
        "y": 320,
        "wires": [["node012"]]
    },
    {
        "id": "node012",
        "type": "function",
        "z": "f1a2b3c4",
        "name": "Format history",
        "func": "var rows = msg.payload;\nif (!rows || rows.length === 0) return null;\nvar temp_msg = {\n  payload: [{\n    series: ['Temperature'],\n    data: [rows.map(r => ({x: r.ts, y: r.temp}))],\n    labels: ['']\n  }]\n};\nvar hum_msg = {\n  payload: [{\n    series: ['Humidity'],\n    data: [rows.map(r => ({x: r.ts, y: r.humidity}))],\n    labels: ['']\n  }]\n};\nreturn [[temp_msg], [hum_msg]];",
        "outputs": 2,
        "noerr": 0,
        "x": 710,
        "y": 320,
        "wires": [["node007"], ["node008"]]
    },
