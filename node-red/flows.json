    {
        "id": "node001",
        "type": "mqtt in",
        "z": "f1a2b3c4",
        "name": "Sensor data",
        "topic": "lnu/iot/fb223gw/sensor",
        "qos": "0",
        "datatype": "json",
        "broker": "broker001",
        "x": 110,
        "y": 100,
        "wires": [["node002", "node004"]]
    },
    {
        "id": "node002",
        "type": "function",
        "z": "f1a2b3c4",
        "name": "Prepare insert",
        "func": "msg.params = {\n  $temp: msg.payload.temp,\n  $humidity: msg.payload.humidity,\n  $ts: Date.now()\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 310,
        "y": 60,
        "wires": [["node003"]]
    },
    {
        "id": "node003",
        "type": "sqlite",
        "z": "f1a2b3c4",
        "mydb": "db001",
        "sqlquery": "prepared",
        "sql": "INSERT INTO readings (temp, humidity, ts) VALUES ($temp, $humidity, $ts)",
        "name": "Insert reading",
        "x": 510,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "node004",
        "type": "function",
        "z": "f1a2b3c4",
        "name": "Split values",
        "func": "return [[{payload: msg.payload.temp}], [{payload: msg.payload.humidity}]];",
        "outputs": 2,
        "noerr": 0,
        "x": 310,
        "y": 140,
        "wires": [["node005", "node007"], ["node006", "node008"]]
    },
    {
        "id": "node005",
        "type": "ui_gauge",
        "z": "f1a2b3c4",
        "name": "Temperature",
        "group": "uigrp001",
        "order": 1,
        "width": 3,
        "height": 3,
        "gtype": "gage",
        "title": "Temperature",
        "label": "°C",
        "format": "{{value}}",
        "min": -20,
        "max": 60,
        "colors": ["#00b4ef", "#f48731", "#ca3838"],
        "seg1": 15,
        "seg2": 30,
        "x": 520,
        "y": 120,
        "wires": []
    },
    {
        "id": "node006",
        "type": "ui_gauge",
        "z": "f1a2b3c4",
